    "@angular/platform-server": "21.1.2",
    "@angular/router": "21.1.2",
    "@angular/ssr": "21.1.2",
    "express": "~4.18.2",
    "rxjs": "~6.6.7",
    "zone.js": "0.16.0"
  },
