    "@angular/language-service": "21.1.2",
    "@cypress/webpack-dev-server": "5.6.0",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "22.4.4",
    "@nx/cypress": "22.4.4",
    "@nx/eslint": "22.4.4",
    "@nx/eslint-plugin": "22.4.4",
