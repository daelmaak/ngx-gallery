{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declarationMap": true,
    "declaration": true,
    "inlineSources": true,
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "preserve",
    "composite": true
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true
  },
  "exclude": [
    "src/test.ts",
    "**/*.spec.ts",
    "cypress/**/*",
    "cypress.config.ts",
    "**/*.cy.ts",
    "**/*.cy.js",
    "**/*.cy.tsx",
    "**/*.cy.jsx"
  ],
  "include": ["src/**/*.ts"]
}
