{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "dom"],
    "sourceMap": true,
    "types": ["cypress", "node"],
    "outDir": "../../dist/out-tsc",
    "moduleResolution": "bundler",
    "module": "preserve",
    "composite": true,
    "declaration": true
  },
  "include": ["src/**/*.ts", "cypress/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/test.ts"],
  "references": [
    { "path": "./tsconfig.lib.json" }
  ]
}
